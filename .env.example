# ---- Database ----
# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Swap the postgresql:// prefix for postgresql+asyncpg:// and drop any ?sslmode=... suffix.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- LLM ----
# Provider switch: "groq" (free, no card) or "gemini" (better vision/multilingual, needs credits)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_key            # console.groq.com → API Keys
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_key            # only used when LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash

# ---- Admin dashboard ----
ADMIN_PASSWORD=changeme

# ---- Active filing year (slips are auto-matched against this) ----
TAX_YEAR=2025

# ---- WhatsApp / Meta Cloud API ----
VERIFY_TOKEN=pick-any-string-and-put-the-same-in-meta
APP_SECRET=your_meta_app_secret
GRAPH_API_VERSION=v21.0
