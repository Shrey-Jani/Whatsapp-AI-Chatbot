# App-level (from your Meta app dashboard)
VERIFY_TOKEN=pick-any-string-and-put-the-same-in-meta
APP_SECRET=your_meta_app_secret
GRAPH_API_VERSION=v21.0

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Swap the postgresql:// prefix for postgresql+asyncpg:// and drop any ?sslmode=... suffix.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
